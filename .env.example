# Copy to .env.local (Next) / .env (worker) and fill in. Every key below is
# validated by src/composition/config.ts — a missing one fails fast at startup.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# true only for local dev (pino-pretty). Never in production.
LOG_PRETTY=true

# --- Datastores ------------------------------------------------------------
DATABASE_URL=postgresql://mysp:mysp@localhost:5432/mysp
REDIS_URL=redis://localhost:6379

# --- Google sign-in (operators) -------------------------------------------
# Needed only when sign-in is switched on, i.e. by the web process (and by
# `pnpm dev` as soon as you open a protected page without DEV_FAKE_SESSION).
# The worker never reads this group: `loadAuthConfig()` is called on demand.
# Create the credentials in Google Cloud Console > OAuth 2.0 Client ID (Web),
# authorised redirect URI: <base-url>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ACCESS CONTROL — read this before changing the three lines below.
# Who may sign in is decided in THIS order:
#   1. AUTH_BOOTSTRAP_ADMINS / AUTH_FACEBOOK_ALLOWED_USER_IDS — exact
#      individuals. They always get in, always count as access admins, and
#      cannot be blocked from the "Quyền truy cập" screen. The escape hatch.
#   2. the access_request table + that screen — where everybody else is
#      approved (with a role) or blocked. A new identity starts "pending".
#
# Comma-separated e-mail DOMAINS that may ATTEMPT a Google sign-in. A FILTER,
# not a grant: matching it only gets the person into the approval queue, and a
# domain must never hand out admin rights (with "mysp.vn" here, every colleague
# would be an unblockable super-admin). BLANK = no domain filter.
AUTH_ALLOWED_DOMAINS=example.com
# Comma-separated EXACT addresses (not domains) that own the escape hatch above.
# Keep it to the one or two people who must be able to fix a broken registry.
AUTH_BOOTSTRAP_ADMINS=
# Sign-in with Facebook (E5.2). Comma-separated Facebook USER ids — not e-mails:
# Facebook does not always return one, so the identity key is the pair
# (provider, user id). This list is the FACEBOOK HALF OF THE ESCAPE HATCH: ids
# in it are bootstrap admins. Blank = no Facebook bootstrap admin; other
# Facebook accounts can still sign in and wait for approval.
# Find your id at https://www.facebook.com/me (or in the "facebook_user_id" log
# line). The provider itself only appears when META_APP_ID and META_APP_SECRET
# are set — otherwise the button is simply absent.
# A successful Facebook sign-in ALSO imports the Pages that account manages,
# using the very token it just issued.
AUTH_FACEBOOK_ALLOWED_USER_IDS=

# --- Google Service Account (Drive + Sheets, E2) ---------------------------
# Read on demand by the catalog sync (`loadGoogleConfig()`), not at boot: the
# web process starts fine without it. Set EXACTLY ONE of the two.
# The service account e-mail must be given read access to the Drive folder and
# to the spreadsheet ("Hàng thiết kế 2026").
# 1) Key file inlined — preferred in Docker (mount as a secret / env):
#    GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n..."}
GOOGLE_SERVICE_ACCOUNT_JSON=
# 2) Or a path to the key file — handy for local dev:
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/mysp-service-account.json
# Drive folder id / spreadsheet id / tab name are NOT env vars: they live in
# tenant_integration.config (one row per tenant, provider = 'google').

# --- Google Drive OAuth (E2 — "Kết nối Google Drive") ----------------------
# Lets a tenant connect THEIR OWN Google account from the sync screen; the sync
# then reads Drive/Sheets with that account instead of the Service Account
# above (which stays the fallback for tenants that never connect).
# Reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET of the sign-in block; only the
# redirect URI differs, so BOTH must be listed under "Authorized redirect URIs"
# of the same OAuth 2.0 Client ID in Google Cloud Console.
# Leave it empty and the connect button answers a message naming this variable
# — nothing else breaks, and manual folder/sheet entry keeps working.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/catalog/google/callback

# --- AI gateway (E4, ADR-001) — read on demand by generate-captions --------
# SINGLE PROVIDER since 15/08/2026: OpenAI only. OPENAI_API_KEY is the sole
# required key; without it no caption can be generated.
OPENAI_API_KEY=
# Google AI Studio key — OPTIONAL, the provider is currently disabled. Leave it
# empty and the adapter is simply not wired. To turn Google back on: put a
# PAID-tier key here (the free tier trains on inputs — ADR-001) AND restore the
# "google:*" entries in the tiers of config/ai-models.yaml.
GOOGLE_AI_API_KEY=
# Model registry file and its in-memory cache TTL (defaults shown).
# AI_MODELS_CONFIG_PATH=./config/ai-models.yaml
# AI_REGISTRY_CACHE_TTL_MS=60000
#
# Swap the model of one tier without editing config/ai-models.yaml. The value is
# a registry KEY from that file's `models:` block, not a raw model name — an
# unknown key does NOT crash the container (the registry is read on the first
# generation, not at boot); it fails every caption request with
# MODEL_NOT_CONFIGURED and logs the list of valid keys.
# Shipped ladder: cheap=openai:gpt-4.1-mini, mid=openai:gpt-5.4-mini,
#                 top=openai:gpt-4.1
# Also declared and selectable: openai:gpt-4o-mini, openai:gpt-5,
#                 openai:gpt-5.4, openai:gpt-5-mini (measured: over-thinks this
#                 prompt and emits nothing — see docs/ai/provider-strategy.md)
# Note: gpt-5* are reasoning models — they reject `temperature` and spend part of
# the output budget thinking. gpt-4.1/4o accept a temperature and do not.
# AI_MODEL_CHEAP=openai:gpt-4.1-mini
# AI_MODEL_MID=openai:gpt-5.4-mini
# AI_MODEL_TOP=openai:gpt-4.1

# --- Facebook / Meta (E5) --------------------------------------------------
# Graph API version used in every request path (https://graph.facebook.com/<v>/...).
# A version is supported for ~2 years; check Meta's changelog before bumping.
# Page ids, Page tokens and the posting spacing are NOT env vars: they live in
# tenant_integration.config (one row per tenant, provider = 'meta') — rule 7.
META_GRAPH_VERSION=v23.0

# --- Facebook connect flow (E5.1) ------------------------------------------
# Read ON DEMAND (loadMetaOAuthConfig), and ALL THREE ARE OPTIONAL — there are
# two ways to connect a Fanpage and they need different things:
#   1) Paste a User Access Token (POST /api/channels/import): needs NOTHING
#      below. The token itself is the credential.
#   2) Facebook Login (GET /api/channels/connect): needs ALL THREE. Without
#      them the button answers a clear message naming the missing variable
#      instead of failing at Facebook.
# With META_APP_SECRET set, a pasted/OAuth token is exchanged for a long-lived
# one (~60 days) and the Page tokens derived from it do not expire. Without it
# the token is used as handed over and the app logs a warning saying so.
# App dashboard: developers.facebook.com > your app > Settings > Basic.
META_APP_ID=
META_APP_SECRET=
# Must match EXACTLY one of the "Valid OAuth Redirect URIs" of the Facebook
# Login product, e.g. https://mysp.example.com/api/channels/callback
META_OAUTH_REDIRECT_URI=http://localhost:3000/api/channels/callback

# --- Media URL + secret encryption (E3 hardening) --------------------------
# Both are read ON DEMAND (loadMediaConfig / loadSecretsConfig), so a process
# that never serves media and never reads a channel token still boots.
#
# HMAC key of the signed image URL Facebook fetches:
#   GET <public-base-url>/api/media/<driveFileId>?tenant=<uuid>&expires=<ms>&sig=<hex>
# At least 32 chars. Generate with: openssl rand -base64 48
# Rotating it invalidates every link already handed to Meta (a queued post then
# fails with UNAUTHORIZED and can simply be retried).
MEDIA_SIGNING_SECRET=
# Public origin Meta fetches signed media URLs from. On the VPS this is the
# Caddy hostname (https://...); locally use the dev server origin.
MEDIA_PUBLIC_BASE_URL=http://localhost:3000
# AES-256-GCM key sealing credentials inside tenant_integration.config
# (values look like enc:v1:<iv>:<tag>:<ciphertext>). Base64 of EXACTLY 32 bytes.
# Generate with: openssl rand -base64 32
# Rotating it makes every sealed value unreadable — re-save the configs first.
# REQUIRED BEFORE CONNECTING ANY CHANNEL (E5.1): every Page/user token is sealed
# with this key on write, so a blank value lets the channel list LOAD but makes
# "Kết nối Fanpage" / import fail with a 400. GET /api/channels reports it as
# `secretsConfigured: false` and the screen warns before a token is pasted.
TENANT_SECRETS_ENC_KEY=

# --- Session ---------------------------------------------------------------
# Canonical public origin used by Auth.js to build OAuth callback URLs. For
# local Docker access via WEB_PORT, use its matching http://localhost:<port>;
# on the VPS use
# the public HTTPS origin (for example https://mysp.example.com).
AUTH_URL=http://localhost:3000
# At least 32 chars. Generate with: openssl rand -base64 48
# Signs the JWT session cookie. Changing it logs everyone out.
SESSION_SECRET=

# --- DEV ONLY: authentication bypass --------------------------------------
# ⚠ Set to "1" ONLY on a local machine. Every request is then treated as the
# fake operator dev@localhost and each one logs a warning.
# It is ignored unless NODE_ENV=development, so a production build has no path
# into it. Leave it unset (or delete the line) to use real Google sign-in.
# DEV_FAKE_SESSION=1
# UI-only demo profile (always enables DEV_FAKE_SESSION, never starts in the
# default deployment): docker compose --profile demo up -d web-demo
# DEMO_WEB_PORT=3001

# --- Worker (BullMQ consumer) ---------------------------------------------
# Parallel jobs per worker process. Keep low: Graph API is rate-limited.
WORKER_CONCURRENCY=5
# Liveness marker refreshed by the worker loop; read by the Docker HEALTHCHECK.
WORKER_HEARTBEAT_FILE=/tmp/mysp-worker-heartbeat
WORKER_HEARTBEAT_INTERVAL_MS=15000
# Graceful-shutdown budget before the worker force-exits (SIGKILL follows in Docker).
WORKER_SHUTDOWN_DEADLINE_MS=30000

# --- Worker: post-job reaper (safety net) ----------------------------------
# Periodic sweep for the two ways a post can go quiet forever:
#  a) stuck in `publishing` (a worker died mid-publish) -> marked failed, NEVER
#     republished automatically; an operator presses "Chạy lại" after checking
#     the Page (a second publish is the worst bug this tool can have);
#  b) scheduled, overdue, and its Redis entry is gone -> re-enqueued (nothing was
#     ever sent, and the stock recheck runs again like on any normal publish).
# How often the sweep runs.
WORKER_REAPER_INTERVAL_MS=300000
# A `publishing` row untouched for this long counts as abandoned.
WORKER_PUBLISHING_STALE_MS=900000
# Grace after the scheduled time before a queued job counts as overdue: spacing
# and retry backoff can legitimately delay it by minutes.
WORKER_OVERDUE_QUEUED_MS=600000
# Rows touched per sweep and per category (a backlog drains across ticks).
WORKER_REAPER_LIMIT=50

# --- Video spec check (E3, Phase 2) -----------------------------------------
# ffprobe ships with the ffmpeg package in the worker image; both defaults work
# out of the box. Override only when the binary lives outside PATH.
# FFPROBE_PATH=ffprobe
# VIDEO_PROBE_TIMEOUT_MS=15000

# --- Uploaded media (E9, chế độ B) ------------------------------------------
# Where the bytes an operator drops into the wizard are stored. Both defaults
# work on a dev box with no setup.
#
# In Docker this MUST be a mounted volume (compose already does it): the files
# have to outlive a container rebuild, because a post that references them can
# be scheduled for tomorrow. The web process writes here and the worker's
# cleanup sweep deletes from here, so BOTH must see the same path.
# UPLOAD_STORAGE_ROOT=./var/uploads
#
# Where a catalog file an operator uploaded instead of connecting a Google
# Sheet is kept (phase 3 — the tenant hands us a CSV). Its OWN directory, not a
# sub-directory of the uploads root: these bytes are that tenant's only product
# data, so the hourly orphan sweep above must never be able to reach them.
# In Docker this is its own named volume (compose already does it).
# CATALOG_STORAGE_ROOT=./var/catalog
#
# How long an uploaded file may sit unreferenced by any post before the hourly
# sweep may remove it. Generous on purpose: it is measured from the upload, and
# an operator may leave a half-composed post open over a lunch break.
# UPLOAD_ORPHAN_TTL_HOURS=24

# --- MinIO object storage (E9, mode B — where the bytes actually live) -----
# `UPLOAD_STORAGE_ROOT` above now only serves the TTL sweep and the one-time
# migration script; since this task, web/worker READ and WRITE mode B bytes
# through MinIO, not the local volume.
#
# TWO endpoints — they must NEVER hold the same value:
#   - MINIO_INTERNAL_ENDPOINT: the host web/worker call for server-side
#     stat/copy/delete. docker-compose.yml HARDCODES this to `minio:9000` (the
#     Docker network service name) — this .env value only matters when running
#     `pnpm dev` OUTSIDE Docker, pointing at a MinIO reachable from the host
#     (e.g. the port a standalone `docker run` MinIO published).
#   - MINIO_PUBLIC_ENDPOINT: the host baked into the SIGNATURE of the
#     upload/download URL handed to the browser (presigned URL). In a real
#     deployment this MUST be the public domain behind the Cloudflare Tunnel —
#     using the internal address there signs URLs that work in local testing
#     and fail for every real user. The value below is the LOCAL one instead:
#     this file is what a developer copies for LOCAL work, so it points at
#     the same loopback MinIO as MINIO_INTERNAL_ENDPOINT, on MINIO_API_PORT
#     further down. The real per-environment values (the actual production
#     and staging hostnames) live in deploy/env/prod.env.example and
#     deploy/env/stg.env.example — never paste those into this file or into a
#     local .env, or a "local" test starts writing into a live bucket.
MINIO_INTERNAL_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# MinIO root user/password — do NOT put a real value here.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=mysp-media
# Internal hop ONLY (MINIO_INTERNAL_ENDPOINT) — never the public one, whose
# TLS comes from MINIO_PUBLIC_ENDPOINT's own scheme. false because compose
# starts MinIO with no certificate; the internal hop is plain HTTP inside the
# Docker network. true here throws EPROTO on every server-side call the
# moment the adapter dials plain HTTP with TLS turned on.
MINIO_USE_SSL=false
# Passed to both clients so the SDK never runs a live `getBucketRegion` lookup
# before signing — a lookup against MINIO_PUBLIC_ENDPOINT (unreachable from the
# container) made SIGNING itself throw, not just the browser's later request.
MINIO_REGION=us-east-1

# --- Drive byte cache (E3.6) ------------------------------------------------
# Facebook fetches every photo URL itself and gives up around 30 seconds, while
# Google Drive answered in 6.7s-99.9s per file on a real 10-photo post (6 of 10
# photos failed with Graph code 324). So the first fetch of an asset stores its
# bytes here and every later fetch is a local read. Both defaults work on a dev
# box with no setup.
#
# In Docker this MUST be a mounted volume shared by web and worker at the SAME
# path: the web process writes on a miss and the worker's hourly sweep deletes
# expired entries. A cache the sweep cannot see is a disk leak.
# MEDIA_CACHE_ROOT=./var/media-cache
#
# How long a cached copy may be served before it is read from Drive again. This
# is the staleness budget: a file REPLACED on Drive under the same id keeps
# serving its old bytes until the entry expires.
# MEDIA_CACHE_TTL_HOURS=72

# --- Docker Compose only ---------------------------------------------------
# Used by the postgres service; DATABASE_URL inside compose is built from them.
POSTGRES_USER=mysp
POSTGRES_PASSWORD=mysp
POSTGRES_DB=mysp
# Host port for the web container (direct access, bypassing Caddy).
WEB_PORT=3000
# Host port for Caddy. 8080 on dev machines so ports 80/443 stay free;
# use 80 (and add 443) on the VPS.
CADDY_HTTP_PORT=8080
# Loopback host port MinIO's API is published on (127.0.0.1 only — see
# docker-compose.yml). On the VPS this is what the edge Caddy proxies
# media.vannt.asia to; each stack sharing the box needs its own value (see
# deploy/env/*.env.example). 9000 is fine on a dev machine with nothing else
# on it.
MINIO_API_PORT=9000
