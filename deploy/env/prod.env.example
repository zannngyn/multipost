# /srv/multipost/.env — the production stack. One stack, one file.
#
# Copy it to the server, fill in every value, `chmod 600`. CI NEVER writes it:
# the pipeline only writes .image-tag.env next to it. That split is deliberate —
# whoever set the box up owns the secrets, and a deploy can never silently
# change one.
#
# Anything generated below uses `openssl rand`. Do not invent secrets by hand.

# --- Stack identity ----------------------------------------------------------
# Compose derives container AND volume names from this. Changing it after the
# first deploy orphans every volume — it is the name of the data, not a label.
COMPOSE_PROJECT_NAME=multipost
IMAGE_PREFIX=ghcr.io/zannngyn/multipost

# --- Edge --------------------------------------------------------------------
# The hostname Traefik matches on (docker-compose.prod.yml turns this into the
# router's Host rule) AND the hostname Cloudflare Tunnel routes here. The two
# must agree or the site answers 404 from Traefik.
#
# Must stay ONE level under vannt.asia: Cloudflare's free Universal SSL covers
# *.vannt.asia only, so `a.b.vannt.asia` has no certificate.
PUBLIC_HOSTNAME=multipost.vannt.asia

# --- Host ports --------------------------------------------------------------
# Loopback only. Traefik reaches the container over the `edge` docker network,
# NOT through this port; it exists for `curl` on the box and for the deploy's
# health probe. Binding 0.0.0.0 would publish the app in plain HTTP on the
# public interface, past Cloudflare — and docker writes its own iptables rules,
# so ufw would not stop it.
WEB_BIND=127.0.0.1
WEB_PORT=3100

# --- Datastores --------------------------------------------------------------
# Postgres and Redis run INSIDE this stack (see docker-compose.yml); only object
# storage is shared with the rest of the box. DATABASE_URL and REDIS_URL are not
# here on purpose — compose builds them from the values below and the in-network
# service names.
POSTGRES_USER=multipost
# openssl rand -hex 24 — hex, NOT base64: this value is pasted into
# DATABASE_URL, and base64's "/" and "+" make it an invalid URL. The failure is
# a `TypeError: Invalid URL` from the migration container, which does not
# mention the password at all.
POSTGRES_PASSWORD=
POSTGRES_DB=multipost

# --- Runtime -----------------------------------------------------------------
LOG_LEVEL=info
WORKER_CONCURRENCY=5
WORKER_SHUTDOWN_DEADLINE_MS=30000
UPLOAD_ORPHAN_TTL_HOURS=24
MEDIA_CACHE_TTL_HOURS=72

# --- Operator sign-in --------------------------------------------------------
# The browser-visible origin. Wrong value = every OAuth callback lands nowhere.
AUTH_URL=https://multipost.vannt.asia
# openssl rand -base64 32
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ACCESS CONTROL (E1.4) — order: (1) the exact-individual lists below are the
# escape hatch (always in, always access admin, cannot be blocked); (2) the
# access_request table + the "Quyền truy cập" screen decide everyone else, and a
# new identity starts "pending".
#
# DOMAIN FILTER for Google sign-in — a filter, never a grant: matching it only
# gets the person into the approval queue. BLANK = no domain filter (safe: the
# registry still has to approve them).
AUTH_ALLOWED_DOMAINS=
# EXACT addresses (not domains) owning the escape hatch. Set at least one before
# the first deploy, or nobody can approve the first operator.
AUTH_BOOTSTRAP_ADMINS=
# Facebook half of the escape hatch: exact user ids (E5.2). Blank = no Facebook
# bootstrap admin; other Facebook accounts can still sign in and wait.
AUTH_FACEBOOK_ALLOWED_USER_IDS=

# --- Google Service Account (Drive + Sheets, E2) -----------------------------
# The whole key file on ONE line — a .env cannot hold a real newline. Wrap it in
# single quotes: the JSON contains double quotes.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Google Drive OAuth (E2 — "Kết nối Google Drive") ------------------------
# Lets a tenant connect THEIR OWN Google account from the sync screen; the sync
# then reads Drive/Sheets with that account instead of the Service Account above
# (which stays the fallback for tenants that never connect).
# Reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET of the sign-in block, so BOTH
# redirect URIs must be registered on the same OAuth 2.0 Client ID.
GOOGLE_OAUTH_REDIRECT_URI=https://multipost.vannt.asia/api/catalog/google/callback

# --- Object storage: the SHARED MinIO in /srv/minio --------------------------
# Provisioned once, per app, on the VPS:
#   /srv/_infra/new-app-s3.sh multipost
# It creates the buckets `multipost` (anonymous read) and `multipost-private`
# (no anonymous access at all) plus a service account limited to those two.
# NEVER put MinIO's root credential here — this app gets its own account.
#
# TWO ENDPOINTS, and mixing them up is the classic failure:
#   INTERNAL — server-side calls, inside the `data` docker network. Skips
#              Cloudflare, so it is not subject to the ~100MB body limit.
#   PUBLIC   — the host baked into the SIGNATURE of every presigned URL handed
#              to a browser. SigV4 signs the Host header, so signing with the
#              internal name produces a perfectly valid signature for a URL no
#              browser can resolve.
MINIO_INTERNAL_ENDPOINT=minio-server:9000
MINIO_PUBLIC_ENDPOINT=https://s3.vannt.asia
# From new-app-s3.sh's output — the service account, not the root user.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# The PRIVATE bucket: every object is served through a presigned URL, never by
# guessing a key.
MINIO_BUCKET=multipost-private
# Describes the INTERNAL hop only, which runs plain HTTP inside the docker
# network (no certificate on the container). The public URL's TLS comes from the
# https:// in MINIO_PUBLIC_ENDPOINT above. `true` here throws EPROTO on every
# server-side call.
MINIO_USE_SSL=false
MINIO_REGION=us-east-1

# --- Cryptographic material --------------------------------------------------
# base64 of exactly 32 random bytes: openssl rand -base64 32
# Rotating this makes every sealed Page token in tenant_integration unreadable.
TENANT_SECRETS_ENC_KEY=
# openssl rand -base64 32 — signs the media URLs Meta fetches. Rotating it
# invalidates links already handed to Facebook.
MEDIA_SIGNING_SECRET=
# Origin Meta fetches signed media from. Must be reachable from the internet.
MEDIA_PUBLIC_BASE_URL=https://multipost.vannt.asia

# --- AI (E4) -----------------------------------------------------------------
OPENAI_API_KEY=
# Google provider is off (owner decision 15/08/2026). Blank = disabled.
GOOGLE_AI_API_KEY=

# --- Facebook (E5) -----------------------------------------------------------
META_GRAPH_VERSION=v23.0
META_APP_ID=
META_APP_SECRET=
# Must match the redirect URI registered in the Meta app, character for character.
META_OAUTH_REDIRECT_URI=https://multipost.vannt.asia/api/channels/callback

# --- Backups (E11.4) ---------------------------------------------------------
BACKUP_INTERVAL=86400
BACKUP_KEEP=7
