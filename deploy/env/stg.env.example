# /srv/mysp/stg/.env — staging stack.
#
# Copy to the server, fill in every value, `chmod 600`. It is NEVER written by
# CI: the pipeline only writes .image-tag.env next to it.
#
# Production uses the same file with different values — see prod.env.example. The
# two stacks share a VPS and stay apart through COMPOSE_PROJECT_NAME, which
# namespaces containers AND volumes, so each has its own database, Redis,
# uploads and backups.

# --- Stack identity ----------------------------------------------------------
# Changing this after the first deploy orphans every volume. It is the name of
# the data, not a label.
COMPOSE_PROJECT_NAME=mysp-stg
IMAGE_PREFIX=ghcr.io/zannngyn/mysp

# --- Host ports --------------------------------------------------------------
# Loopback only. The VPS's own Caddy (systemd) is the public door and proxies to
# this port — see deploy/edge/mysp.caddy, where the SAME number appears.
# Changing WEB_PORT means changing that file and reloading Caddy, or the site
# 502s. Binding 0.0.0.0 instead would serve the app over plain HTTP on the
# public IP, past the proxy and past its certificate.
WEB_BIND=127.0.0.1
WEB_PORT=3110
# The per-stack caddy is not started (deploy uses --scale caddy=0); the value
# only has to differ between the two stacks so a manual `up` cannot collide.
CADDY_HTTP_PORT=8091

# --- Datastores --------------------------------------------------------------
POSTGRES_USER=mysp
# openssl rand -hex 24 — hex, NOT base64: this value is pasted into
# DATABASE_URL, and base64's "/" and "+" make it an invalid URL. The failure is
# a `TypeError: Invalid URL` from the migration container, which does not
# mention the password at all.
POSTGRES_PASSWORD=
POSTGRES_DB=mysp

# --- Runtime -----------------------------------------------------------------
LOG_LEVEL=debug
WORKER_CONCURRENCY=2
WORKER_SHUTDOWN_DEADLINE_MS=30000
UPLOAD_ORPHAN_TTL_HOURS=24
MEDIA_CACHE_TTL_HOURS=72

# --- Operator sign-in --------------------------------------------------------
# The browser-visible origin. Wrong value = every OAuth callback lands nowhere.
AUTH_URL=https://mysp-stg.vannt.asia
# openssl rand -base64 32
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_ALLOWED_DOMAINS=
# Comma-separated Facebook user ids (E5.2). Blank = nobody signs in with
# Facebook, which is the safe default, not a broken one.
AUTH_FACEBOOK_ALLOWED_USER_IDS=

# --- Google Service Account (Drive + Sheets, E2) -----------------------------
# The whole key file on ONE line — a .env cannot hold a real newline. Wrap it in
# single quotes: the JSON contains double quotes.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Google Drive OAuth (E2 — "Kết nối Google Drive") ------------------------
# Lets a tenant connect THEIR OWN Google account from the sync screen; the sync
# then reads Drive/Sheets with that account instead of the Service Account above
# (which stays the fallback for tenants that never connect).
# Reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET of the sign-in block, so BOTH
# redirect URIs must be registered on the same OAuth 2.0 Client ID.
GOOGLE_OAUTH_REDIRECT_URI=https://mysp-stg.vannt.asia/api/catalog/google/callback

# --- Cryptographic material --------------------------------------------------
# base64 of exactly 32 random bytes: openssl rand -base64 32
# Rotating this makes every sealed Page token in tenant_integration unreadable.
TENANT_SECRETS_ENC_KEY=
# openssl rand -base64 32 — signs the media URLs Meta fetches. Rotating it
# invalidates links already handed to Facebook.
MEDIA_SIGNING_SECRET=
# Origin Meta fetches signed media from. Must be reachable from the internet.
MEDIA_PUBLIC_BASE_URL=https://mysp-stg.vannt.asia

# --- AI (E4) -----------------------------------------------------------------
# A staging generation costs the same as a production one and bills the same
# account. Use a separate key with its own budget cap if the provider allows it.
OPENAI_API_KEY=
# Google provider is off (owner decision 15/08/2026). Blank = disabled.
GOOGLE_AI_API_KEY=

# --- Facebook (E5) -----------------------------------------------------------
META_GRAPH_VERSION=v23.0
META_APP_ID=
META_APP_SECRET=
# Must match the redirect URI registered in the Meta app, character for character.
META_OAUTH_REDIRECT_URI=https://mysp-stg.vannt.asia/api/channels/callback

# --- Backups (E11.4) ---------------------------------------------------------
BACKUP_INTERVAL=86400
BACKUP_KEEP=2
