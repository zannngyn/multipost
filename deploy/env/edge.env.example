# /srv/mysp/edge/.env — the shared Caddy in front of both stacks.
#
# Both hostnames must be "DNS only" on Cloudflare (grey cloud, type A, pointing
# at this VPS's public IP). With the orange proxy on, Cloudflare terminates TLS
# and Caddy can never finish the ACME challenge.
PROD_DOMAIN=mysp.vannt.asia
STG_DOMAIN=mysp-stg.vannt.asia

# Let's Encrypt expiry warnings go here. A wrong address means the first thing
# you learn about an expired certificate is a user complaining.
ACME_EMAIL=ladyphongit@gmail.com
