# Site blocks for the VPS's own Caddy (systemd, not a container).
#
# This box already ran Caddy on :80/:443 for other sites before MYSP existed, so
# MYSP does not bring its own proxy — it borrows that one. Each stack publishes
# its web port on 127.0.0.1 (WEB_BIND in the stack .env) and Caddy is the only
# thing reaching it, which is also what keeps the app off the public IP in
# plain HTTP.
#
# Installed to /etc/caddy/conf.d/mysp.caddy by deploy/bootstrap.sh, which also
# adds `import /etc/caddy/conf.d/*.caddy` to /etc/caddy/Caddyfile. Kept in its
# own file so nothing here can disturb the site blocks that were already there.
#
# Ports must match WEB_PORT in the matching .env:
#   3100 -> /srv/mysp/prod   3110 -> /srv/mysp/stg
# Same for MinIO's MINIO_API_PORT (E9 — the loopback host port docker-compose.yml
# publishes `minio` on, never 0.0.0.0: the bucket is private, but the console and
# API still must not sit on the public interface):
#   9100 -> /srv/mysp/prod   9110 -> /srv/mysp/stg
#
# After editing:  caddy validate --config /etc/caddy/Caddyfile && systemctl reload caddy

(mysp_app) {
	encode zstd gzip

	# Explicit access log (goes to journald via stderr) so what gets recorded
	# is a decision, not a default. The format is `filter` around json because
	# two URL shapes carry bearer credentials and must never land verbatim in
	# any log this box keeps:
	#   /join/<token>        single-use invite token (possession = membership)
	#   ...?sig=<hmac>       signed media URL (possession = the file bytes)
	# The app layer already redacts its own logs (src/app/_lib/redact-path.ts);
	# this closes the remaining layer, the edge access log. One regexp handles
	# both shapes; Referer gets the same treatment because a browser leaving
	# the /join page repeats the full URL there.
	#
	# KNOWN GAP: per-request ERROR entries (http.log.error.*, e.g. "no
	# upstreams available" while the app is down) travel through the box's
	# `default` logger, which only global options can filter — and a conf.d
	# snippet must not declare global options in a Caddyfile it does not own.
	# Those entries embed the full URI, so during an app outage a /join or
	# sig= hit can land verbatim in journald (root-readable only). Closing it
	# means adding the same `log { format filter ... }` to the global options
	# block of /etc/caddy/Caddyfile by hand. deploy/caddy/Caddyfile shows the
	# exact block — it closes the same gap for the container stack.
	log {
		format filter {
			wrap json
			fields {
				request>uri regexp "(/join/)[^/?]+|([?&](?:sig|token)=)[^&]*" "${1}${2}<redacted>"
				request>headers>Referer regexp "(/join/)[^/?]+|([?&](?:sig|token)=)[^&]*" "${1}${2}<redacted>"
			}
		}
	}

	# Long enough for a Drive fetch plus a Graph upload to finish inside one
	# request; short enough that a wedged upstream is not held open forever.
	reverse_proxy {args[0]} {
		health_uri /api/health
		health_interval 30s
		health_timeout 5s

		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}
}

mysp.vannt.asia {
	import mysp_app 127.0.0.1:3100
}

mysp-stg.vannt.asia {
	# Staging is a real deployment holding real Page tokens — keep it out of
	# search results.
	header X-Robots-Tag "noindex, nofollow"
	import mysp_app 127.0.0.1:3110
}

(minio_media) {
	# NOT `mysp_app`: MinIO has no /api/health, so reusing that snippet's
	# health_uri would mark the upstream permanently unhealthy and refuse
	# every request. `/minio/health/live` is MinIO's own unauthenticated
	# liveness endpoint.
	log {
		format filter {
			wrap json
			fields {
				# Presigned URLs are AWS SigV4 — possession of X-Amz-Signature is
				# possession of the file, exactly like `sig=` on the app's own
				# signed media URLs above. Same redaction discipline.
				request>uri regexp "([?&]X-Amz-Signature=)[^&]*" "${1}<redacted>"
				request>headers>Referer regexp "([?&]X-Amz-Signature=)[^&]*" "${1}<redacted>"
			}
		}
	}

	# Generous enough for a large video upload/download to finish inside one
	# request; short enough that a wedged upstream is not held open forever.
	reverse_proxy {args[0]} {
		health_uri /minio/health/live
		health_interval 30s
		health_timeout 5s

		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}
}

media.vannt.asia {
	import minio_media 127.0.0.1:9100
}

media-stg.vannt.asia {
	header X-Robots-Tag "noindex, nofollow"
	import minio_media 127.0.0.1:9110
}
