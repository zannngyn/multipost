# Hostname routing for both stacks on this VPS.
#
# The upstream names are the network aliases set by docker-compose.prod.yml
# (STACK_ALIAS + "-web"), not compose service names: container names are
# project-scoped and would change with COMPOSE_PROJECT_NAME.
#
# A stack that is down breaks only its own hostname — Caddy resolves the
# upstream per request, so the edge starts fine with either stack missing.
{
	email {$ACME_EMAIL}
}

(app) {
	encode zstd gzip

	log {
		output stdout
		format json
	}

	# Caddy streams request bodies, so no size cap is set here; upload limits
	# are the app's business, not the proxy's.
	reverse_proxy {args[0]} {
		health_uri /api/health
		health_interval 30s
		health_timeout 5s

		# Long enough for a Drive fetch plus a Graph upload to finish inside one
		# request; short enough that a wedged upstream is not held open forever.
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}
}

{$PROD_DOMAIN} {
	import app mysp-prod-web:3000
}

{$STG_DOMAIN} {
	# Staging is a real deployment holding real Page tokens — keep it out of
	# search results.
	header X-Robots-Tag "noindex, nofollow"
	import app mysp-stg-web:3000
}
