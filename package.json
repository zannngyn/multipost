{
  "name": "mysp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "depcruise": "depcruise src --validate",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm lint && pnpm depcruise && pnpm test && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/adapters/db/seed.ts",
    "worker": "tsx src/worker/index.ts",
    "worker:dev": "tsx watch src/worker/index.ts",
    "queue:demo": "tsx src/worker/enqueue-demo.ts"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@tanstack/react-query": "^5.101.4",
    "bullmq": "^6.0.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "googleapis": "^174.0.1",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "next-auth": "5.0.0-beta.32",
    "openai": "^7.4.0",
    "pino": "^10.0.0",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dependency-cruiser": "^17.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "pino-pretty": "^13.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.21.0"
}
