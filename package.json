{
  "name": "mysp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "depcruise": "depcruise src --validate",
    "test": "vitest run",
    "test:integration": "vitest run src/adapters/db/db-errors.integration.test.ts",
    "theme:check": "astryx theme build --check src/ui/theme/mysp-theme.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm depcruise && pnpm theme:check && pnpm theme:presets:check && pnpm test && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file-if-exists=.env src/adapters/db/seed.ts",
    "worker": "tsx --env-file-if-exists=.env src/worker/index.ts",
    "worker:dev": "tsx watch --env-file-if-exists=.env src/worker/index.ts",
    "queue:demo": "tsx --env-file-if-exists=.env src/worker/enqueue-demo.ts",
    "theme:presets": "tsx scripts/build-theme-presets.ts",
    "theme:presets:check": "tsx scripts/build-theme-presets.ts --check"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.4.0",
    "@astryxdesign/theme-neutral": "^0.4.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@google/genai": "^2.16.0",
    "@hookform/resolvers": "^5.7.1",
    "@stylexjs/stylex": "^0.19.0",
    "@tanstack/react-query": "^5.101.4",
    "bullmq": "^6.0.11",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^13.1.1",
    "googleapis": "^174.0.1",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "next-auth": "5.0.0-beta.32",
    "openai": "^7.4.0",
    "pino": "^10.0.0",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.4.0",
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dependency-cruiser": "^17.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "pino-pretty": "^13.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.21.0"
}
