# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# playwright mcp scratch output (snapshots, console logs, screenshots)
.playwright-mcp/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local git worktrees created by tooling
/.claude/worktrees/
.claude/skills/

# E9 — operator-uploaded media on a dev box (UPLOAD_STORAGE_ROOT default).
# In Docker this lives in a volume, never in the repo.
/var/

# local dev scratch (never commit - dev.log once leaked invite tokens)
dev.log
dev-debug.log
devpid.txt
